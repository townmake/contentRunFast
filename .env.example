# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3

# 选品系统（也可在 Admin → 选品连接配置 填写，Admin 优先于此处）
XUANPIN_MCP_BASE_URL=https://pro.linzz.cn/mcp/
XUANPIN_MCP_API_KEY=mcp_your_key_here
XUANPIN_HTTP_BASE_URL=https://pro.linzz.cn
# 选品 Listing 只读未就绪时先用 fixture 联调导入（1=开）
XUANPIN_USE_FIXTURES=0
# 本地联调示例：
# XUANPIN_MCP_BASE_URL=http://127.0.0.1:8000/mcp/
# XUANPIN_HTTP_BASE_URL=http://127.0.0.1:8000
# XUANPIN_USE_FIXTURES=1

# 美客多（MVP）
MELI_SITE_ID=MLB
MELI_ACCESS_TOKEN=
MELI_APP_ID=
MELI_CLIENT_SECRET=
# 本地无真实 Token 时可开模拟发布
MELI_DRY_RUN=0

# AI 图像（按供应商填写）
AI_IMAGE_PROVIDER=
AI_IMAGE_API_KEY=
